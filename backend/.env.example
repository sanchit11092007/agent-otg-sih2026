# ==============================================================================
# Agent OTG - Environment Configuration Template
# ==============================================================================
#
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# --- Models (must match `ollama list`) ---
CODER_MODEL=qwen2.5-coder:latest
MAIN_MODEL=qwen2.5:7b
COMPLEX_MODEL=qwen2.5:14b
FAST_MODEL=qwen2.5:7b
IMAGE_MODEL=qwen2.5vl:7b

# --- RAG / Embeddings ---
RAG_LLM_MODEL=qwen2.5:7b
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_VISION_MODEL=qwen2.5vl:7b

# RAG retrieval tuning
RAG_TOP_K=8
RAG_FETCH_K=25
RAG_MAX_CONTEXT_DOCS=8
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# RAG features
RAG_ENABLE_MULTI_QUERY=false
RAG_ENABLE_SEMANTIC_SPLITTER=false
RAG_QUERY_EXPANSION=false

# --- Ollama Server ---
OLLAMA_BASE_URL=http://localhost:11434

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agent_otg
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# --- Smart Routing ---
SMART_ROUTING_ENABLED=true
DIRECT_14B_MODE=true
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1536
MEMORY_MAX_TURNS=6
MEMORY_MAX_CHARS=12000
IMAGE_GEN_MODEL=stabilityai/sd-turbo
IMAGE_GEN_LOCAL_ONLY=false
IMAGE_GEN_SIZE=512

# --- App Info ---
APP_VERSION=2.1.0
